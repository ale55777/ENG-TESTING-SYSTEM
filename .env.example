# Copy to .env (scripts/setup.ps1 does this for you) and fill in the values.
# NEVER commit .env. Secrets below are read by the BACKEND only.

APP_ENV=development

# --- Groq (https://console.groq.com/keys) ---------------------------------
# Enables AI exercise generation, Whisper transcription and AI feedback.
# Without it: typing, predefined exercises and the offline pronunciation model still work,
# and an offline (lower-accuracy) local recognizer is used for speech.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Ably (https://ably.com/accounts -> your app -> API Keys) --------------
# Full key "appId.keyId:secret" with publish+subscribe+history capability. Used server-side only to
# publish events and to sign short-lived browser tokens. Without it the UI falls back to HTTP polling.
ABLY_API_KEY=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=english
POSTGRES_PASSWORD=english
POSTGRES_DB=english_learning
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://english:english@localhost:5433/english_learning

# --- Auth ---------------------------------------------------------------------
# Long random string. setup.ps1 generates one locally. Required when APP_ENV=production.
JWT_SECRET=
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# --- Local models (no API key needed) ----------------------------------------
SUPERTONIC_MODEL_PATH=./backend/models/supertonic3
PRONUNCIATION_MODEL_PATH=./backend/models/wav2vec2-base-960h

# --- Optional SMTP for password-reset emails ----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (public, safe to expose) ----------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ABLY_AUTH_URL=http://localhost:8000/api/v1/realtime/token
